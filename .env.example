# Directus Core Configuration
PUBLIC_URL=https://directus.your-domain.com
SECRET=your-directus-secret-key
DEFAULT_ROLE_ID=36010211-604f-4ce3-84d9-4e69d16781a1

# Keycloak Configuration
KEYCLOAK_URL=https://keycloak.your-domain.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your-secure-password
# AUTH_KEYCLOAK_ISSUER_URL=https://keycloak.your-domain.com/realms/your-realm
# AUTH_KEYCLOAK_IDENTIFIER_KEY=sub # key to extract from Keycloak profile (sub or email, defaults to sub)
# AUTH_KEYCLOAK_FIND=external_identifier # field to search existing user by (external_identifier or email)

# Mobile App & Client Configuration
MOBILE_APP_SCHEME=myapp
MOBILE_APP_CALLBACK_PATH=/auth/callback
GOOGLE_CALLBACK_PATH=/auth/callback/google
APPLE_CLIENT_ID=com.example.app1,com.example.app2

# Web SSO & Cookie Configuration
COOKIE_DOMAIN=.your-domain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=directus_session_token
REFRESH_TOKEN_COOKIE_NAME=directus_refresh_token
ALLOWED_REDIRECT_DOMAINS=goyong.net

# Google Analytics 4 (GA4) Integration
GA_PROPERTY_ID=353061378
# GA_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GA_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Firebase Cloud Messaging (FCM) Integration
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FCM_WEBHOOK_SECRET=your-webhook-secret

# Legacy SSO Bridge (Optional)
# ENABLE_LEGACY_BRIDGE=false
